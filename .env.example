POSTGRES_USER=argus
POSTGRES_PASSWORD=change-me
POSTGRES_DB=argus

# Created on the first start, then ignored. At least 8 characters, and not
# "change-me" or "change-me-too".
ARGUS_ADMIN_EMAIL=admin@example.com
ARGUS_ADMIN_PASSWORD=

# Host port for the web UI.
ARGUS_WEB_PORT=8080

# Set to true when a reverse proxy serves the UI over HTTPS.
#ARGUS_COOKIE_SECURE=true

# Encrypts monitor credentials at rest. openssl rand -hex 32
# Set it on the first start and keep a copy. Without it, those credentials
# cannot be read back.
#ARGUS_SECRET_KEY=

# Reverse proxies in front of Argus, counting this compose file's web
# container. Leave unset when browsers open ARGUS_WEB_PORT directly.
# Set 2 when nginx, Caddy, or Traefik sits in front.
#ARGUS_TRUSTED_PROXIES=1
