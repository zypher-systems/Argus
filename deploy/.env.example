POSTGRES_USER=argus
POSTGRES_PASSWORD=change-me
POSTGRES_DB=argus

# The first administrator, created on the first start and ignored after that.
# Argus will not start for the first time until the password is set: at least
# 8 characters, and your own.
ARGUS_ADMIN_EMAIL=admin@example.com
ARGUS_ADMIN_PASSWORD=

ARGUS_WEB_PORT=8080

# Set to true when Argus sits behind HTTPS.
#ARGUS_COOKIE_SECURE=true

# Hosted multi-org mode, for the hosted build only (GO_TAGS=hosted); the
# published images ignore it. Registration creates a new org + admin.
# Cookie Secure defaults on when hosted; set ARGUS_COOKIE_SECURE=false for HTTP.
#ARGUS_HOSTED=true
# Stored on organizations created by registration. It does not lock features.
#ARGUS_HOSTED_PLAN=community

# deploy/docker-compose.release.yml only. The root docker-compose.yml already
# names ghcr.io/zypher-systems/argus/backend and web. Pin a version tag or a
# digest here if you use the release file.
#ARGUS_IMAGE_BACKEND=ghcr.io/zypher-systems/argus/backend:v2.16.0
#ARGUS_IMAGE_WEB=ghcr.io/zypher-systems/argus/web:v2.16.0

# Encrypts monitor credentials (database passwords, HTTP auth) at rest.
# Generate with: openssl rand -hex 32
# Back it up: without it those credentials cannot be decrypted, and the
# monitors that use them will fail to authenticate until they are re-entered.
#ARGUS_SECRET_KEY=

# Reverse proxies in front of the API, counting the bundled web container.
# Leave at 1 when browsers reach ARGUS_WEB_PORT directly. Set 2 when nginx,
# Caddy or Traefik sits in front of it, and 3 when a CDN sits in front of that.
# Too low and every visitor shares one rate limit; too high and a visitor can
# choose the address rate limits and the audit log see.
#ARGUS_TRUSTED_PROXIES=1
